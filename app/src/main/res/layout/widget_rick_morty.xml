<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/tvWidgetMultiverse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MULTIVERSO"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#83D52E" />

    <ImageView
        android:id="@+id/ivWidgetPortal"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:alpha="0.30"
        android:scaleType="fitCenter"
        android:src="@drawable/portal_vortex" />

    <ImageView
        android:id="@+id/ivWidgetCharacter"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/portal_vortex" />

    <LinearLayout
        android:id="@+id/widgetCharacterContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWidgetMultiverse"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="95dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWidgetCharacterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rick Sanchez"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#062432"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivWidgetStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_status_alive" />

            <TextView
                android:id="@+id/tvWidgetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Alive"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#14752A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:text="•"
                android:textSize="12sp"
                android:textColor="#8C969B" />

            <TextView
                android:id="@+id/tvWidgetSpecies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Human"
                android:textSize="12sp"
                android:textColor="#65717A"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnWidgetOpen"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:text="Ver personaje"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#062432"
        android:background="@drawable/widget_button_background" />

</RelativeLayout>